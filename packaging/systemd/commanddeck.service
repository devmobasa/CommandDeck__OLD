[Unit]
Description=CommandDeck launcher daemon
Documentation=https://github.com/devmobasa/commanddeck
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/commanddeck daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-%h/.config/commanddeck -%h/.local/state/commanddeck

[Install]
WantedBy=graphical-session.target
